.idea
*.log
.claude/settings.local.json
.config/clipcdn/config
.config/nvim/spell/*.spl

# onedrive keeps its refresh_token and sync database next to the config
.config/onedrive/*
!.config/onedrive/config
!.config/onedrive/sync_list

# ~/.ssh is folded into the repo when it does not exist yet, keep keys out of git
.ssh/*
!.ssh/config
