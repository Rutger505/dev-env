#!/bin/bash
set -euo pipefail

log() { printf '[gsr-clip-share] %s\n' "$*"; }
trap 'log "failed at line $LINENO: $BASH_COMMAND"; notify-send -u critical "Clip delen mislukt"' ERR

# Where gsr-ui saves replays: replay.save_directory in its config (JSON, or
# "key value" lines in older versions), else the XDG videos dir.
gsr_config="${XDG_CONFIG_HOME:-$HOME/.config}/gpu-screen-recorder/config_ui"
clips_dir=""
if [ -f "$gsr_config" ]; then
  clips_dir="$(jq -r '.replay.save_directory // empty' "$gsr_config" 2>/dev/null \
    || sed -n 's/^replay\.save_directory //p' "$gsr_config")"
fi
clips_dir="${clips_dir:-$(xdg-user-dir VIDEOS 2>/dev/null || echo "$HOME/Videos")}"
log "replay directory: $clips_dir"

# gsr-ui writes the clip in the root and only moves it into a per-window
# subfolder once it's complete, so clips in subfolders are always finished.
# Names only have second precision and a save in the same second overwrites the
# previous one, so new clips are recognised by mtime instead of by path.
newest_since() {
  find "$clips_dir" -mindepth 2 -type f -name '*.mp4' -newermt "@$1" -printf '%T@ %p\n' | sort -n | tail -1 | cut -d' ' -f2-
}

start="$(date +%s.%N)"
log "gsr-ui-cli ${1:-replay-save}"
gsr-ui-cli "${1:-replay-save}"

clip=""
for _ in $(seq 1 60); do
  sleep 0.5
  clip="$(newest_since "$start")"
  if [ -n "$clip" ]; then break; fi
done

if [ -z "$clip" ]; then
  log "no new clip in $clips_dir after 30s, is replay running in gsr-ui?"
  false
fi
log "clip: $clip ($(stat -c%s "$clip") bytes)"

name="$(basename "$clip" | tr ' ' '_' | tr -cd 'A-Za-z0-9._-')"
log "uploading to homecdn/clips/$name"
# 5s plus 1s per 10 MB, a 120 MB clip normally uploads in ~2s so this leaves plenty of slack
upload_timeout=$((5 +$(stat -c%s "$clip") / 10000000))
uploaded=""
for attempt in 1 2 3; do
  if timeout "$upload_timeout" mcli cp --quiet "$clip" "homecdn/clips/$name"; then uploaded=1; break; fi
  log "upload attempt $attempt failed or timed out after ${upload_timeout}s"
done
if [ -z "$uploaded" ]; then
  log "upload failed after 3 attempts"
  false
fi

url="https://cdn.rutgerpronk.com/clips/$name"
printf '%s' "$url" | wl-copy
log "uploaded: $url"
notify-send "Clip geüpload" "URL gekopieerd naar klembord"
