#!/bin/bash
set -euo pipefail

clips_dir="$HOME/Videos/Clips"

newest() {
  find "$clips_dir" -type f -name '*.mp4' -printf '%T@ %p\n' | sort -n | tail -1 | cut -d' ' -f2-
}

before="$(newest)"

gsr-ui-cli "${1:-replay-save}"

# gsr-ui writes the clip asynchronously, wait until a new file stops growing
clip=""
for _ in $(seq 1 60); do
  sleep 0.5
  cand="$(newest)"
  if [ -n "$cand" ] && [ "$cand" != "$before" ]; then
    s1=$(stat -c%s "$cand")
    sleep 0.5
    s2=$(stat -c%s "$cand")
    if [ "$s1" = "$s2" ] && [ "$s1" -gt 0 ]; then clip="$cand"; break; fi
  fi
done

[ -n "$clip" ] || { notify-send "clip-share" "geen nieuwe clip gevonden"; exit 1; }

base="$(basename "$clip")"
key="clips/$(echo "$base" | tr ' ' '_' | tr -cd 'A-Za-z0-9._-')"

notify-send "clip uploaden…" "$base"
mcli cp "$clip" "homecdn/cdn/$key" >/dev/null
url="https://cdn.rutgerpronk.com/cdn/$key"

printf '%s' "$url" | wl-copy
notify-send "clip geüpload 📋" "$url"
