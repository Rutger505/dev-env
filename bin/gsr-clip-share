#!/bin/bash
set -euo pipefail
trap 'notify-send -u critical "Clip delen mislukt"' ERR

clips_dir="$HOME/Videos/Clips"

newest() {
  find "$clips_dir" -type f -name '*.mp4' -printf '%T@ %p\n' | sort -n | tail -1 | cut -d' ' -f2-
}

before="$(newest)"

gsr-ui-cli "${1:-replay-save}"

# gsr-ui writes the clip asynchronously, wait until a new file stops growing
clip=""
for _ in $(seq 1 60); do
  sleep 0.5
  cand="$(newest)"
  if [ -n "$cand" ] && [ "$cand" != "$before" ]; then
    s1=$(stat -c%s "$cand")
    sleep 0.5
    s2=$(stat -c%s "$cand")
    if [ "$s1" = "$s2" ] && [ "$s1" -gt 0 ]; then clip="$cand"; break; fi
  fi
done

[ -n "$clip" ]

key="clips/$(basename "$clip" | tr ' ' '_' | tr -cd 'A-Za-z0-9._-')"
mcli cp "$clip" "homecdn/cdn/$key" >/dev/null
printf '%s' "https://cdn.rutgerpronk.com/cdn/$key" | wl-copy
notify-send "Clip geüpload" "URL gekopieerd naar klembord"
