#!/bin/bash
set -euo pipefail

log() { printf '[gsr-clip-share] %s\n' "$*"; }
trap 'log "failed at line $LINENO: $BASH_COMMAND"; notify-send -u critical "Clip delen mislukt"' ERR

clips_dir="$HOME/Videos/Clips"

newest() {
  find "$clips_dir" -type f -name '*.mp4' -printf '%T@ %p\n' | sort -n | tail -1 | cut -d' ' -f2-
}

before="$(newest)"
log "newest clip before save: ${before:-none}"

log "gsr-ui-cli ${1:-replay-save}"
gsr-ui-cli "${1:-replay-save}"

# gsr-ui writes the clip asynchronously, wait until a new file stops growing
clip=""
for _ in $(seq 1 60); do
  sleep 0.5
  cand="$(newest)"
  if [ -n "$cand" ] && [ "$cand" != "$before" ]; then
    s1=$(stat -c%s "$cand")
    sleep 0.5
    s2=$(stat -c%s "$cand")
    if [ "$s1" = "$s2" ] && [ "$s1" -gt 0 ]; then clip="$cand"; break; fi
  fi
done

if [ -z "$clip" ]; then
  log "no new clip in $clips_dir after 60s"
  false
fi
log "clip: $clip ($(stat -c%s "$clip") bytes)"

name="$(basename "$clip" | tr ' ' '_' | tr -cd 'A-Za-z0-9._-')"
log "uploading to homecdn/clips/$name"
mcli cp --quiet "$clip" "homecdn/clips/$name"

url="https://cdn.rutgerpronk.com/clips/$name"
printf '%s' "$url" | wl-copy
log "uploaded: $url"
notify-send "Clip geüpload" "URL gekopieerd naar klembord"
