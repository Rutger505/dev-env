#!/bin/bash
# monitors.lua keeps the panel at 60Hz to save battery, reload restores it
hyprctl -q eval 'hl.monitor({ output = "eDP-1", mode = "1920x1080@144", position = "0x0", scale = 1 })'
trap 'hyprctl -q reload' EXIT

# The laptop session limits VK_ICD_FILENAMES to the iGPU, which hides the dGPU from prime-run's Vulkan layer
VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json prime-run "$@"
