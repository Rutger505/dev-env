#!/bin/bash
# monitors.lua keeps the panel at 60Hz to save battery, reload restores it
hyprctl -q eval 'hl.monitor({ output = "eDP-1", mode = "1920x1080@144", position = "0x0", scale = 1 })'
trap 'hyprctl -q reload' EXIT

# The laptop session hides the dGPU from Vulkan, CUDA and EGL, so undo each of those here
VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json \
  CUDA_VISIBLE_DEVICES=0 \
  __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_nvidia.json:/usr/share/glvnd/egl_vendor.d/50_mesa.json \
  prime-run "$@"
