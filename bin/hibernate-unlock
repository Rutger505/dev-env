#!/bin/bash

# The lock screen ignores an empty password, so type a throwaway one that PAM accepts
# right after a hibernate resume. Keys typed before the lock takes input are lost, so
# retype every 0.2s; waiting that long first keeps a retype out of the desktop
# when an unlock is still finishing.
for _ in {1..150}; do
  case $(omarchy-shell lock isLocked) in
    true)
      ydotool type x
      ydotool key 28:1 28:0
      ;;
    false)
      exit 0
      ;;
  esac
  sleep 0.2
done
