#!/bin/bash

cd "$(dirname "$(realpath "$0")")/.." || exit 1
error_file="${DEV_ENV_ERROR_FILE:-$HOME/.local/state/dev-env-sync-error}"

fail() {
  echo "$1"
  touch "$error_file"
  exit 1
}

spell_file=.config/nvim/spell/en.utf-8.add
if ! git diff --quiet HEAD -- "$spell_file"; then
  git commit --quiet -m "chore(nvim): update spell word list" -- "$spell_file" || fail "Committing the spell file failed"
fi

git diff --quiet HEAD || fail "Repository has uncommitted changes"
git fetch || fail "Fetch failed"

if [ -n "$(git rev-list '@{upstream}..@')" ]; then
  git push || fail "Push failed"
fi

if git diff --quiet @ '@{upstream}' && [ ! -f "$error_file" ]; then
  exit 0
fi

git merge --ff-only '@{upstream}' || fail "Local branch diverged from upstream"
stow --adopt --restow --target="$HOME" . || fail "Stow failed"
rm -f "$error_file"
