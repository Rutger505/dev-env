# Packages this machine does not need — mostly Omarchy preinstalls.
#
# Source: ~/.local/share/omarchy/install/omarchy-base.packages (Omarchy 4.0.0 "Quattro"),
# plus a few leftovers from Omarchy 3.
# Consumed by: applications/post-install/arch/remove-unused-applications.sh
#
# This file is deliberately NOT under applications/packages/, because the
# installer loads every *.lst it finds there and would install these again.
#
# Sizes are installed size of the package itself; `pacman -Rns` also reclaims
# dependencies that nothing else needs, so real savings are higher.
#
# Machine this was assessed against: MSI B550 desktop, Ryzen 5 5600X,
# Radeon RX 9070 XT, 3 external monitors, Canon MG2900 printer, zsh + tmux,
# Zen/Brave browsers, VSCode + JetBrains + Neovim.


### Preinstalled apps with a replacement already installed ###################

libreoffice-fresh        # 421 MB. Last opened Dec 2025.
kdenlive                 #  90 MB. omacut covers the clip trimming.
localsend                #  67 MB. Nothing pairs with it; clipcdn covers sharing.
cliamp                   #  35 MB. Retro Winamp clone; Spotify is installed.
obsidian                 #  25 MB. Last opened May 2026.
pinta                    #  20 MB. Drags in dotnet-runtime for a Paint clone.
aether                   #  19 MB. Wallpaper->theme generator; themes are pinned.
herdr                    #  18 MB. tmux replacement. Its shell integration is
                         #  bash-only (~/.local/share/omarchy/default/bash/fns/herdr)
                         #  and this machine runs zsh, so it is unreachable anyway.
xournalpp                #   8 MB. PDF annotation; config dir created by the
                         #  Quattro upgrade and never touched since.
moonlight-qt             #   2 MB. Game-streaming client on the machine that
                         #  would be the *host*, not the client.
omawrite                 # 0.6 MB. Markdown editor; VSCode/nvim installed.
omacalc                  # 0.3 MB. Calculator; qalculate is installed.
tobi-try                 # 0.1 MB. "Fresh directories for every vibe" scratch-dir toy.
ttfx                     #   2 MB. Terminal text effects. A toy.


### Runtimes and libs only these apps pulled in ##############################

dotnet-runtime           #  74 MB. Only pinta required it.
libvips                  #  31 MB. Nothing on the system requires it.
mariadb-libs             #  24 MB. Optional dep of libreoffice-fresh / qt-base only.
postgresql-libs          #  11 MB. Same.
python-poetry-core       #   2 MB. Python build backend; poetry itself isn't installed.
luarocks                 # Unused by the nvim configs: no `rocks` setting anywhere,
                         # no ~/.local/share/nvim*/lazy-rocks tree, and no ~/.luarocks.
                         # nui.nvim is the only plugin shipping a rockspec, and
                         # lazy.nvim skips it (has a lua/ dir, no dependencies,
                         # build.type = "builtin"), so luarocks is never invoked.
                         # lazy.nvim's rocks.hererocks defaults to nil, so it would
                         # bootstrap its own luarocks if a rock ever were needed.
qemu-user-static-binfmt  # binfmt rules for cross-arch emulation; qemu-user-static
                         # is not installed, so the rules bind nothing.


### Hardware that is not in this machine #####################################

asdcontrol               # Brightness for Apple Studio/Pro USB-C displays.
bolt                     # Thunderbolt 3 device manager; B550 has no Thunderbolt.


### Duplicated by dev-env's own package lists ################################

gnome-disk-utility       # 7 MB. gparted + udisks2 are installed via dev-env.
foot                     # Ghostty is the terminal here: ~/.config/xdg-terminals.list
                         # lists com.mitchellh.ghostty.desktop and nothing else, so
                         # foot is never reached by xdg-terminal-exec.
alacritty                # Not installed (Omarchy 3 leftover); listed so a fresh
kitty                    # install of dev-env on an older box cleans up too.


### Outside Omarchy's preinstall set, but still not wanted ###################

losslesscut-bin          # 574 MB. Biggest single win in this file. Electron app
                         # for lossless trims; omacut does the same job and is
                         # already preinstalled. Nothing requires it.
openai-codex-desktop     # The ChatGPT desktop app, offered by Omarchy's
                         # "Install > AI" menu (omarchy-install-ai-chatgpt).
                         # Not installed here; listed so it stays gone.
discover-overlay         # Third-party Discord voice overlay (GTK). Discord
                         # itself stays; only the overlay is unwanted.
gnome-multi-writer       # 0.4 MB. Writes one ISO to several USB sticks at once.
                         # balena-etcher is installed and nothing here flashes
                         # more than one stick at a time.
typora                   # Not installed (only a stale .desktop was left behind);
                         # listed so other machines drop it. VSCode/nvim edit
                         # Markdown here.


### Omarchy 3 leftovers ######################################################

signal-desktop           # Not installed here; kept for older machines.
1password-beta           # Same; Bitwarden is the password manager in dev-env.
