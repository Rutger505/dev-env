From b83161d23922bbf8f02165ccaa54e8a272be6300 Mon Sep 17 00:00:00 2001
From: Rutger Pronk <rutger.pronk11@gmail.com>
Date: Mon, 7 Sep 2026 22:34:10 +0200
Subject: [PATCH] perf(init): hoist mouse-scroll lookup and batch bind-key
 calls

Startup ran one 'tmux show-option' per key in the copy-mode table (88 keys
here) plus an awk fork per matching line, then a separate tmux invocation
per binding. Reading @smooth-scroll-mouse once, splitting the key out with
bash, and sending every bind-key in a single tmux command produces the
identical set of bindings in 21ms instead of 270ms.
---
 src/init.sh | 26 ++++++++++++++++++--------
 1 file changed, 18 insertions(+), 8 deletions(-)

diff --git a/src/init.sh b/src/init.sh
index 7ea31a7..fb6a7df 100755
--- a/src/init.sh
+++ b/src/init.sh
@@ -6,15 +6,20 @@ MODE_KEYS="$(tmux show-option -gwq mode-keys)"
 TABLE="copy-mode-vi"
 [ "$MODE_KEYS" = "emacs" ] && TABLE="copy-mode"
 
+MOUSE_SCROLL="$(config__mouse_scroll)"
+
+# Collected into one tmux invocation: a bind-key per scroll key costs a fork.
+BINDS=()
+
 # Find keys bound to scroll commands and rebind
-tmux list-keys -T "$TABLE" | while IFS= read -r line; do
+while IFS= read -r line; do
     # Skip mouse wheel events if explicitly disabled
-    if [ "$(config__mouse_scroll)" = "false" ]; then
+    if [ "$MOUSE_SCROLL" = "false" ]; then
         case "$line" in
             *Wheel*) continue ;;
         esac
     fi
-    
+
     case "$line" in
         *send-keys*scroll-up|*scroll.sh*up*normal*)         params="up normal" ;;
         *send-keys*scroll-down|*scroll.sh*down*normal*)     params="down normal" ;;
@@ -24,17 +29,22 @@ tmux list-keys -T "$TABLE" | while IFS= read -r line; do
         *send-keys*page-down|*scroll.sh*down*fullpage*)     params="down fullpage" ;;
         *) continue ;;
     esac
-    
-    key=$(echo "$line" | awk '{print $4}')
+
+    read -ra fields <<< "$line"
+    key="${fields[3]}"
     [ -z "$key" ] && continue
 
+    [ "${#BINDS[@]}" -gt 0 ] && BINDS+=(";")
+
     case "$key" in
         Wheel*Pane)
             # Wheel bindings need the mouse pane passed into scroll.sh.
-            tmux bind-key -T "$TABLE" "$key" run-shell -b -t = "TMUX_PANE=#{pane_id} $SRC_DIR/scroll.sh $params"
+            BINDS+=(bind-key -T "$TABLE" "$key" run-shell -b -t = "TMUX_PANE=#{pane_id} $SRC_DIR/scroll.sh $params")
             ;;
         *)
-            tmux bind-key -T "$TABLE" "$key" run-shell -b "$SRC_DIR/scroll.sh $params"
+            BINDS+=(bind-key -T "$TABLE" "$key" run-shell -b "$SRC_DIR/scroll.sh $params")
             ;;
     esac
-done
+done < <(tmux list-keys -T "$TABLE")
+
+[ "${#BINDS[@]}" -gt 0 ] && tmux "${BINDS[@]}"
-- 
2.55.0

